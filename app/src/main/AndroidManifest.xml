<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Read-only. Vehicle SDK 2.3.2 @RequiresPermission (docs/compliance/REVIEW.md §2).
         The app never calls any Vehicle SDK set* function; no CONTROL_*, INTERNET or location permission. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- Gear -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- Wiper -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- LowBeam -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />  <!-- Defroster, steering heat -->
    <!-- Temporary: declared by the official sample; drop once wiper reads are verified without it. -->
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- CarUxRestrictions (driving restriction). Optional: plain emulators have no Car service. -->
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!-- Not distraction-optimized: AAOS blocks this activity while driving (safety level L0). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
